{
  "name": "sliceurl-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply sliceurl-db --local --env local",
    "db:migrate:remote": "wrangler d1 migrations apply sliceurl-db --remote"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.8.3",
    "wrangler": "^4.4.0"
  }
}
